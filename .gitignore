# Python-generated artifacts at any repository depth
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.egg-info/
**/*.egg
**/.eggs/
**/build/
**/dist/

# Python tool state at any repository depth
**/.pytest_cache/
**/.hypothesis/
**/.mypy_cache/
**/.ruff_cache/
**/.pytype/
**/.pyre/
**/.tox/
**/.nox/
**/.ipynb_checkpoints/
**/__pypackages__/
**/pytestdebug.log

